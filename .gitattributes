# Ignore .yy files for language statistics
*.yy linguist-generated=true
 
# force LF for metadata files for merge simplicity
*.gml text eol=lf
*.yy text eol=lf
*.yyp text eol=lf
*.json text eol=lf

# assets pass through untouched, whatever a clone has autocrlf set to
*.ogg binary
*.wav binary
*.mp3 binary
*.png binary